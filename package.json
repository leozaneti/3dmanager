{
  "name": "3d-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:auth": "concurrently \"npm:dev:auth:api\" \"npm:dev:web\"",
    "dev:api": "tsc -p tsconfig.server.json && env DB_ENV=dev AUTH_ENABLED=false node dist-server/index.js",
    "dev:auth:api": "tsc -p tsconfig.server.json && env DB_ENV=dev AUTH_ENABLED=true node dist-server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "start": "env DB_ENV=prod node dist-server/index.js",
    "backup": "env DB_ENV=prod tsx server/scripts/backup.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^8.1.1",
    "@fastify/static": "^7.0.4",
    "@tanstack/react-query": "^5.59.16",
    "fastify": "^4.29.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
